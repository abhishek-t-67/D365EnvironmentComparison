<?xml version="1.0" encoding="utf-8"?>
<!--
  XrmToolBox Tool Library package for the D365 Environment Comparison Tool.
  Rules (from the XrmToolBox "Deploy your tool in Tool Library" guide and validation checklist):
    - the package version MUST equal the tool assembly version (2.0.0 <-> 2.0.0.0), or users get an update prompt that never clears
    - the tool DLLs go under a "Plugins" folder inside lib\net48
    - the dependency is on "XrmToolBox" (not "XrmToolBoxPackage")
    - an icon URL and a project URL must be defined (see the TODO lines below)
-->
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>D365EnvironmentComparison</id>
    <version>2.0.0</version>
    <title>D365 Environment Comparison Tool</title>
    <authors>Abhishek</authors>
    <description>Compares two Dynamics 365 / Dataverse environments (for example DEV and UAT) and lists the configuration differences between them, ranked ERROR, WARN and INFO. Compares solutions, environment variables, connection references, plugin steps, web resources, business rules, workflows, actions, process flows and cloud flows. Scope by publisher, solution and area. Read-only: it only queries Dataverse.</description>
    <summary>Finds configuration drift between two Dynamics 365 / Dataverse environments. Read-only.</summary>
    <releaseNotes>2.0.0: renamed to D365 Environment Comparison Tool. Compares ten component areas between two environments, scoped by publisher, solution and area; explains missing items; filters on every column; ignore list; CSV export.</releaseNotes>
    <tags>XrmToolBox Dynamics365 D365 Dataverse CRM Environment Comparison Compare Drift Deployment ALM</tags>
    <icon>icon.png</icon>
    <readme>README.md</readme>

    <!-- TODO before publishing: both are required by the Tool Library validation.
         iconUrl must be a PUBLIC URL to your own icon (not XrmToolBox's). projectUrl can be a repo, blog post or page.
    <iconUrl>https://TODO-public-url-to-icon.png</iconUrl>
    <projectUrl>https://TODO-project-page</projectUrl>
    -->

    <!-- TODO before publishing: choose a licence, then add one of these:
    <license type="expression">MIT</license>
    <licenseUrl>...</licenseUrl>
    -->

    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <!-- minimum XrmToolBox version this tool was built against -->
        <dependency id="XrmToolBox" version="1.2025.7.71" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\src\D365EnvironmentComparison\bin\Release\net48\D365EnvironmentComparison.dll" target="lib\net48\Plugins" />
    <file src="..\src\D365EnvironmentComparison\bin\Release\net48\D365EnvironmentComparison.Core.dll" target="lib\net48\Plugins" />
    <file src="icon.png" target="" />
    <file src="README.md" target="" />
  </files>
</package>
